#!/bin/sh
# Fetches the TrueNAS update payload named by update_url= on the kernel cmdline into a tmpfs
# mounted on /cdrom, at the exact path the stock installer mounts it from.
#
# Kernel cmdline:
#   update_url=<url>        required -- where to fetch the .update payload from
#   update_sha256=<hex>     optional -- expected sha256 of the payload. If absent, it's looked up
#                           by filename in the SHA256SUMS next to update_url (extract-iso.sh
#                           writes one into every version folder). Verification is on by
#                           default and fails closed: no hash found means no install.
#   update_sha256=off       turn verification off entirely
set -eu

installer_py=/usr/lib/python3/dist-packages/truenas_installer/install.py

cmdline_value()
{
  # /proc/cmdline is one line of space-separated parameters -- word splitting is the point.
  # shellcheck disable=SC2013
  for arg in $(cat /proc/cmdline)
  do
    case "${arg}" in
      "$1"=*)
        echo "${arg#*=}"
        return 0
        ;;
    esac
  done
  return 1
}

if ! url=$(cmdline_value update_url)
then
  echo "opbevaring: no update_url= on the kernel cmdline, nothing to do"
  exit 0
fi
sha=$(cmdline_value update_sha256) || sha=""

# Resolve the expected hash before the (~2 GiB) download, so a missing or incomplete SHA256SUMS
# fails in seconds rather than after the transfer.
if [ "${sha}" = "off" ]
then
  echo "opbevaring: update_sha256=off -- payload will NOT be verified"
  sha=""
elif [ -z "${sha}" ]
then
  sums_url="${url%/*}/SHA256SUMS"
  name="${url##*/}"
  echo "opbevaring: looking up ${name} in ${sums_url}"
  if ! sums=$(curl --fail --silent --show-error --location --retry 5 --retry-delay 5 --retry-connrefused "${sums_url}")
  then
    echo "opbevaring: could not fetch ${sums_url} -- pass update_sha256=<hex>, or update_sha256=off" >&2
    exit 1
  fi
  sha=$(echo "${sums}" | awk -v n="${name}" '$2 == n || $2 == "*" n { print $1; exit }')
  if [ -z "${sha}" ]
  then
    echo "opbevaring: no entry for ${name} in ${sums_url} -- pass update_sha256=<hex>, or update_sha256=off" >&2
    exit 1
  fi
fi

# The filename changes between releases (TrueNAS-SCALE.update in 25.10.2.1, TrueNAS.update on
# truenas-installer's master branch), so read it from the installer that's actually about to
# consume it rather than hardcoding either.
target=$(grep -o '/cdrom/[^"]*\.update' "${installer_py}" | head -n 1)
if [ -z "${target}" ]
then
  echo "opbevaring: could not find the /cdrom/*.update path in ${installer_py}" >&2
  exit 1
fi

mkdir -p /cdrom
if ! mountpoint -q /cdrom
then
  # size= is a ceiling, not a reservation -- tmpfs only consumes what's actually written.
  mount -t tmpfs -o size=4G,mode=0755 opbevaring /cdrom
fi

echo "opbevaring: fetching ${url} -> ${target}"
if ! curl --fail --location --retry 5 --retry-delay 5 --retry-connrefused --progress-bar \
  --output "${target}.part" "${url}" 2>/dev/console
then
  echo "opbevaring: download of ${url} failed" >&2
  rm -f "${target}.part"
  exit 1
fi

if [ -n "${sha}" ]
then
  echo "opbevaring: verifying sha256 ${sha}"
  if ! echo "${sha}  ${target}.part" | sha256sum -c -
  then
    echo "opbevaring: sha256 mismatch for ${url}" >&2
    rm -f "${target}.part"
    exit 1
  fi
fi

# install.py loop-mounts this as squashfs; catch an HTML error page or a truncated file here,
# with a clear message, rather than as an obscure mount failure halfway through an install.
if [ "$(head -c 4 "${target}.part")" != "hsqs" ]
then
  echo "opbevaring: ${url} is not a squashfs image" >&2
  rm -f "${target}.part"
  exit 1
fi

mv "${target}.part" "${target}"
chmod 0444 "${target}"
echo "opbevaring: ${target} ready"
